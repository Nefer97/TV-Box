{
  "http_port": 8765,

  "chrome": {
    "binary": "google-chrome-stable",
    "profile_dir": "~/.config/tvbox-chrome",
    "cdp_port": 9222,
    "device_scale_factor": "auto",
    "disable_gpu": false,
    "force_h264": true
  },

  "remote": {
    "match": ["IR Receiver", "Apple IR"],
    "long_press_ms": 800,
    "ok_long_press_ms": 1500,
    "repeat_ms": 170,
    "repeat_delay_ms": 600,
    "debounce_ms": 220,
    "pointer_speed_px_s": 640,
    "pointer_delay_ms": 300,
    "pointer_nudge_px": 12
  },

  "screen": { "video_mode": "1280x720" },
  "audio":  { "mixer": "Master", "volume_step": 5 },
  "player": { "seek_back_s": 10, "seek_forward_s": 30 },

  "identities": {
    "samsung_tv": "Mozilla/5.0 (Linux; Tizen 2.3) AppleWebKit/538.1 (KHTML, like Gecko) Version/2.3 TV Safari/538.1 HbbTV/1.5.1 (+DRM;Samsung;SmartTV2027;T-HKM6DEUC-1490.3;;)",
    "ps4_leanback": "Mozilla/5.0 (PS4; Leanback Shell) Gecko/20100101 Firefox/65.0 LeanbackShell/01.00.01.75 Sony PS4/ (PS4, , no, CH)"
  },

  "home": {
    "sections": [
      { "title": "", "big": true,
        "items": ["raiplay", "mediaset", "youtube", "altri"] },
      { "title": "Canali in diretta", "channels": true }
    ],
    "other": ["siti", "mediaset_web", "discovery", "raiplay_web", "la7", "raiplaysound", "plutotv", "netflix", "sc", "impostazioni"]
  },

  "services": {
    "raiplay":      { "kind": "hbbtv", "identity": "samsung_tv", "label": "RaiPlay", "subtitle": "App per TV · dirette e on demand",
                      "icon": "play", "color": "#1d4ed8",
                      "url": "https://www.raiplay.it/hbbtv/wsA6DXk6W7Khjpn3/RaiPlay2020/index.html" },
    "mediaset":     { "kind": "page", "page": "mediaset", "label": "Mediaset Infinity", "subtitle": "Fiction, serie, programmi e cartoni",
                      "icon": "play", "color": "#0f766e", "logo_url": "https://mediasetinfinity.mediaset.it/" },
    "mediaset_web": { "kind": "web", "label": "Mediaset Infinity (sito)", "icon": "play", "color": "#0f766e",
                      "auto_fullscreen": true, "url": "https://mediasetinfinity.mediaset.it/" },
    "youtube":      { "kind": "tvapp", "identity": "ps4_leanback", "label": "YouTube", "subtitle": "Video, musica e canali",
                      "icon": "youtube", "no_logo": true, "color": "#b91c1c",
                      "url": "https://www.youtube.com/tv" },
    "altri":        { "kind": "page", "page": "altri", "label": "Altri servizi", "subtitle": "La7, Pluto TV, i tuoi siti…",
                      "icon": "grid", "color": "#6d28d9" },
    "impostazioni": { "kind": "page", "page": "settings", "label": "Impostazioni", "subtitle": "Wi-Fi, volume, schermata",
                      "icon": "gear", "color": "#374151" },
    "siti":         { "kind": "page", "page": "siti", "label": "I miei siti", "icon": "globe", "color": "#0e7490" },




    "discovery":    { "kind": "web", "label": "discovery+", "subtitle": "Real Time, DMAX, Nove… gratis",
                      "icon": "play", "color": "#1d4ed8", "auto_fullscreen": true,
                      "url": "https://www.discoveryplus.com/it/it" },
    "raiplay_web":  { "kind": "web", "label": "RaiPlay (sito)", "icon": "play", "color": "#1e3a8a", "auto_fullscreen": true,
                      "url": "https://www.raiplay.it/" },
    "la7":          { "kind": "web", "label": "La7 diretta", "icon": "tv", "color": "#9a3412", "auto_fullscreen": true,
                      "url": "https://www.la7.it/dirette-tv" },
    "raiplaysound": { "kind": "web", "label": "Radio Rai", "icon": "radio", "color": "#1e40af",
                      "url": "https://www.raiplaysound.it/" },
    "plutotv":      { "kind": "web", "label": "Pluto TV", "icon": "tv", "color": "#854d0e",
                      "url": "https://pluto.tv/it/live-tv" },
    "netflix":      { "kind": "web", "label": "Netflix", "icon": "play", "color": "#7f1d1d",
                      "player_control": "keys", "hover": false,
                      "url": "https://www.netflix.com/browse" },
    "sc":          { "kind": "page", "page": "sc", "label": "StreamingCommunity", "subtitle": "Serie TV, film e anime in streaming",
                      "icon": "play", "color": "#1a1a1a",  "auto_fullscreen": true, "url": "https://streaming-community.army/theme/images/logo.png" }
  }
}
